# GovAsset 360 - Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.

# Firebase Configuration (Create a project in Firebase Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Google Gemini API Key (For AI Assistant grounded in Firestore data)
# Get a key from Google AI Studio (https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key
